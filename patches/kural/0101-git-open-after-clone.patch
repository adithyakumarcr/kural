+
+/**
+ * Kural: whether all windows share one frame (the workbench command `_kural.oneFrame`, only in Kural built from source).
+ * Then "Open" must not replace this window's project (its chats would stop): the project opens in a new window that
+ * takes the frame. Anywhere else the command does not exist, and this is `false`.
+ */
+export async function isOneFrame(): Promise<boolean> {
+	try {
+		return (await commands.executeCommand<{ enabled?: boolean } | undefined>('_kural.oneFrame'))?.enabled === true;
+	} catch {
+		return false;
+	}
+}

{
  "name": "kural",
  "displayName": "Kural",
  "description": "Kural Code Editor's AI: Tab Completion, chat with tabs and agents (Ctrl+L), inline edit (Ctrl+K), Ask. With Claude (your Claude Code login) or your own model on this computer (Ollama, offline).",
  "version": "1.1.0-alpha.4",
  "publisher": "kural",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:kural.chat",
    "onView:kural.search",
    "onWebviewPanel:kural.chatEditor"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you haven't trusted, Kural ignores that folder's settings for which programs to run and how much the AI may do on its own, and doesn't load the folder's Claude Code setup (hooks, MCP servers).",
      "restrictedConfigurations": [
        "kural.claudePath", "kural.codexPath", "kural.agyPath", "kural.tabCompletion.ollamaUrl",
        "kural.chat.mode", "kural.chat.fullClaudeCodeSetup", "kural.chat.model"
      ]
    }
  },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kural.tab.forget",
        "title": "Kural: Forget What Tab Completion Learned (This Workspace)"
      },
      {
        "command": "kural.chat.open",
        "title": "Kural: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kural.chat.newTab",
        "title": "Kural: New Chat Tab",
        "icon": "$(add)"
      },
      {
        "command": "kural.chat.nextTab",
        "title": "Kural: Next Chat Tab"
      },
      {
        "command": "kural.chat.prevTab",
        "title": "Kural: Previous Chat Tab"
      },
      {
        "command": "kural.chat.closeTab",
        "title": "Kural: Close Chat Tab"
      },
      {
        "command": "kural.askSearch",
        "title": "Kural: Ask",
        "icon": "$(search)"
      },
      {
        "command": "kural.inlineEdit",
        "title": "Kural: Edit Inline (Ctrl+K)",
        "icon": "$(sparkle)"
      },
      {
        "command": "kural.review.accept",
        "title": "Kural: Accept Change"
      },
      {
        "command": "kural.review.reject",
        "title": "Kural: Reject Change"
      },
      {
        "command": "kural.toggleTab",
        "title": "Kural: Turn Tab Completion On/Off"
      },
      {
        "command": "kural.openClaudeCode",
        "title": "Kural: Open Claude Code",
        "icon": "$(terminal)"
      },
      {
        "command": "kural.getStarted",
        "title": "Get Started",
        "icon": "$(rocket)",
        "category": "Kural"
      },
      {
        "command": "kural.showUsage",
        "title": "Show AI Usage (limits and when they reset)",
        "icon": "$(dashboard)",
        "category": "Kural"
      },
      {
        "command": "kural.account",
        "title": "Account: Usage, Switch Account, Log Out",
        "icon": "$(account)",
        "category": "Kural"
      },
      {
        "command": "kural.devices",
        "title": "Devices (SSH): Terminal, Link to Chat, Password, Remove",
        "category": "Kural",
        "icon": "$(remote)"
      },
      {
        "command": "kural.devices.add",
        "title": "Add a Device (SSH)",
        "category": "Kural"
      },
      {
        "command": "kural.devices.terminal",
        "title": "Open a Terminal on a Device (SSH)",
        "category": "Kural"
      },
      {
        "command": "kural.login",
        "title": "Kural: Log In to Claude"
      },
      {
        "command": "kural.install",
        "title": "Kural: Install Claude Code"
      },
      {
        "command": "kural.showLog",
        "title": "Kural: Show Log",
        "icon": "$(output)"
      },
      {
        "command": "kural.chat.history",
        "title": "Kural: Chat History",
        "icon": "$(history)"
      },
      {
        "command": "kural.chat.nextModel",
        "title": "Kural: Next Model (Opus → Sonnet → Haiku)"
      },
      {
        "command": "kural.chat.effortMedium",
        "title": "Kural: Intensity Medium"
      },
      {
        "command": "kural.chat.effortHigh",
        "title": "Kural: Intensity High"
      },
      {
        "command": "kural.chat.effortMax",
        "title": "Kural: Intensity Max"
      },
      {
        "command": "kural.chat.togglePlan",
        "title": "Kural: Plan Mode On/Off"
      },
      {
        "command": "kural.chat.attach",
        "title": "Kural: Attach Files to Chat"
      },
      {
        "command": "kural.tabSpeed",
        "title": "Kural: Tab Completion Speed"
      },
      {
        "command": "kural.reloadSetup",
        "title": "Kural: Reload Claude Code Setup (connectors, MCP, plugins)"
      },
      {
        "command": "kural.checkForUpdates",
        "title": "Check for Updates...",
        "category": "Kural"
      },
      {
        "command": "kural.chat.split",
        "title": "Kural: Open a Chat Beside the Code",
        "icon": "$(split-horizontal)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kural-search",
          "title": "Ask",
          "icon": "media/search-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "kural",
          "title": "Kural",
          "icon": "media/chat-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "kural-tab",
          "title": "Tab Completion",
          "icon": "media/chat-icon.svg"
        },
        {
          "id": "kural-usage",
          "title": "AI Usage",
          "icon": "media/usage-icon.svg"
        }
      ]
    },
    "views": {
      "kural-search": [
        {
          "type": "webview",
          "id": "kural.search",
          "name": "Ask"
        }
      ],
      "kural": [
        {
          "type": "webview",
          "id": "kural.chat",
          "name": "Chat",
          "initialSize": 30
        }
      ],
      "kural-tab": [
        {
          "type": "webview",
          "id": "kural.tabPanel",
          "name": "Tab Completion"
        }
      ],
      "kural-usage": [
        {
          "type": "webview",
          "id": "kural.usagePanel",
          "name": "AI Usage"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kural.chat.newTab",
          "when": "view == kural.chat",
          "group": "navigation@1"
        },
        {
          "command": "kural.chat.split",
          "when": "view == kural.chat",
          "group": "navigation@2"
        },
        {
          "command": "kural.openClaudeCode",
          "when": "view == kural.chat",
          "group": "navigation@3"
        },
        {
          "command": "kural.showLog",
          "when": "view == kural.chat",
          "group": "navigation@4"
        },
        {
          "command": "kural.account",
          "when": "view == kural.chat",
          "group": "9_kural@1"
        },
        {
          "command": "kural.getStarted",
          "when": "view == kural.chat",
          "group": "9_kural@2"
        },
        {
          "command": "kural.checkForUpdates",
          "when": "view == kural.chat",
          "group": "9_kural@3"
        }
      ],
      "editor/title": [
        {
          "command": "kural.chat.open",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "kural.inlineEdit",
          "when": "editorTextFocus",
          "group": "0_kural@1"
        },
        {
          "command": "kural.chat.open",
          "when": "editorHasSelection",
          "group": "0_kural@2"
        },
        {
          "command": "kural.askSearch",
          "group": "0_kural@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kural.review.accept",
          "when": "kural.reviewPending"
        },
        {
          "command": "kural.review.reject",
          "when": "kural.reviewPending"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kural.chat.open",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "!terminalFocus"
      },
      {
        "command": "kural.chat.newTab",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "kural.chat.nextTab",
        "key": "ctrl+pagedown",
        "mac": "cmd+alt+right",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.prevTab",
        "key": "ctrl+pageup",
        "mac": "cmd+alt+left",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.askSearch",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "kural.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "kural.review.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "kural.reviewPending && editorTextFocus"
      },
      {
        "command": "kural.review.reject",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "kural.reviewPending && editorTextFocus"
      },
      {
        "command": "kural.openClaudeCode",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "kural.chat.effortMedium",
        "key": "ctrl+m",
        "mac": "ctrl+m",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.effortHigh",
        "key": "ctrl+h",
        "mac": "ctrl+h",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.effortMax",
        "key": "ctrl+o",
        "mac": "ctrl+o",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.togglePlan",
        "key": "ctrl+p",
        "mac": "ctrl+p",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.toggleTab",
        "key": "ctrl+alt+space",
        "mac": "ctrl+alt+space"
      }
    ],
    "configuration": {
      "title": "Kural",
      "properties": {
        "kural.claudePath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Where the `claude` program (Claude Code) is. Leave empty to find it automatically; set it only if Kural can't find yours (Get started → *Choose the claude file…*)."
        },
        "kural.codexPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Where the `codex` program (OpenAI's Codex CLI) is. Leave empty to find it automatically."
        },
        "kural.agyPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Where the `agy` program (Google's Antigravity CLI, for Google Gemini) is. Leave empty to find it automatically."
        },
        "kural.tabCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tab Completion: show suggestions as grey text as you type. Tab accepts."
        },
        "kural.tabCompletion.model": {
          "type": "string",
          "default": "haiku",
          "enum": [
            "haiku",
            "sonnet",
            "opus"
          ],
          "description": "Claude model for Tab Completion (when it uses Claude). Haiku is fastest (about half a second)."
        },
        "kural.tabCompletion.debounceMs": {
          "type": "number",
          "default": 75,
          "minimum": 0,
          "maximum": 2000,
          "description": "How fast suggestions come: ms to wait after your last key (0 = as you type). Easiest to set from Tab Completion in the status bar."
        },
        "kural.chat.model": {
          "type": "string",
          "default": "sonnet",
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ],
          "description": "Model for your very first chat. After that, new chats use whatever you picked last."
        },
        "kural.chat.intensity": {
          "type": "string",
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ],
          "description": "Intensity for your very first chat. After that, new chats use whatever you picked last."
        },
        "kural.chat.mode": {
          "type": "string",
          "default": "agent",
          "enum": [
            "agent",
            "auto",
            "plan",
            "ask"
          ],
          "enumDescriptions": [
            "Kural edits files; asks before running commands",
            "Kural edits files and runs commands without asking",
            "Kural writes a plan first; click Build it to carry it out",
            "Answers only; nothing changes"
          ],
          "description": "Mode for your very first chat. After that, new chats use whatever you picked last."
        },
        "kural.chat.fullClaudeCodeSetup": {
          "type": "boolean",
          "default": true,
          "description": "Chat uses your whole Claude Code setup: connectors and MCP servers, plugins, skills, hooks, settings. Kural reloads it in the same conversation when it changes. Off = a faster, minimal setup (your CLAUDE.md and .claude/rules are still used)."
        },
        "kural.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Text size in the Kural chat and Ask panels, in pixels. `0` = the same as your code editor (`editor.fontSize`)."
        },
        "kural.tabCompletion.engine": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "local",
            "claude"
          ],
          "enumDescriptions": [
            "The local model when Ollama has it (fastest), otherwise Claude",
            "Always the local model (Claude only if Ollama isn't available)",
            "Always Claude"
          ],
          "description": "What writes Tab Completion suggestions. Easiest to set in the Tab Completion panel (click Tab Completion in the status bar)."
        },
        "kural.tabCompletion.localModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b-base",
          "description": "Ollama model for local Tab Completion suggestions (a base model with fill-in-the-middle, e.g. qwen2.5-coder:0.5b-base / 1.5b-base / 3b-base)."
        },
        "kural.tabCompletion.ollamaUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:11434",
          "description": "Where Ollama runs."
        },
        "kural.localModels.contextLength": {
          "type": "number",
          "default": 32768,
          "minimum": 16384,
          "markdownDescription": "How many tokens a model on your computer (Ollama) can look at in the chat: your conversation, the files it read, Kural's instructions. 32k works well; more needs more memory."
        },
        "kural.tabCompletion.terminal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Tab in the terminal too: one suggested command line in the terminal's suggestion list (e.g. a commit message named from your changes). Uses the same engine and model as Tab in the editor."
        },
        "kural.updates.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "Check for a new Kural version once a day (it asks before installing anything)."
        }
      }
    },
    "themes": [
      {
        "label": "Kural Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kural-dark-color-theme.json"
      },
      {
        "label": "Kural Light",
        "uiTheme": "vs",
        "path": "./themes/kural-light-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Kural Dark",
      "github.branchProtection": false,
      "github.showAvatar": false,
      "github.gitAuthentication": false,
      "workbench.preferredDarkColorTheme": "Kural Dark",
      "workbench.preferredLightColorTheme": "Kural Light",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "chat.commandCenter.enabled": false,
      "chat.disableAIFeatures": true,
      "editor.fontSize": 14,
      "editor.lineHeight": 1.6,
      "editor.minimap.enabled": false,
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.renderLineHighlight": "all",
      "editor.inlineSuggest.enabled": true,
      "editor.guides.bracketPairs": "active",
      "workbench.list.smoothScrolling": true,
      "terminal.integrated.fontSize": 14,
      "workbench.activityBar.location": "default",
      "workbench.sideBar.location": "left",
      "workbench.experimental.fontSize": 14,
      "workbench.sideBar.experimental.fontSize": 14,
      "workbench.tabs.experimental.fontSize": 14,
      "workbench.bottomPane.experimental.fontSize": 14,
      "workbench.statusBar.experimental.fontSize": 13,
      "terminal.integrated.suggest.quickSuggestions": {
        "commands": "on",
        "arguments": "on",
        "unknown": "on"
      },
      "terminal.integrated.suggest.suggestOnTriggerCharacters": true
    },
    "terminal": {
      "completionProviders": [
        {
          "description": "Tab Completion: one suggested command line (e.g. a commit message named from your changes), from the same model as Tab in the editor."
        }
      ]
    }
  },
  "author": "Adithya Chinnakkonda",
  "enabledApiProposals": [
    "terminalCompletionProvider",
    "terminalDataWriteEvent"
  ]
}

{
  "name": "kural",
  "displayName": "Kural",
  "description": "Kural Code Editor's AI: Tab Completion, chat with tabs and agents (Ctrl+L), inline edit (Ctrl+K), Ask. With Claude (your Claude Code login) or your own model on this computer (Ollama, offline).",
  "version": "1.1.0-alpha.6",
  "publisher": "kural",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:kural.chat",
    "onView:kural.search",
    "onWebviewPanel:kural.chatEditor",
    "onCustomEditor:kural.chatTab"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you haven't trusted, Kural ignores that folder's settings for which programs to run and how much the AI may do on its own, and doesn't load the folder's Claude Code setup (hooks, MCP servers).",
      "restrictedConfigurations": [
        "kural.claudePath",
        "kural.codexPath",
        "kural.agyPath",
        "kural.tabCompletion.ollamaUrl",
        "kural.chat.mode",
        "kural.chat.fullClaudeCodeSetup",
        "kural.chat.model",
        "kural.modelRouter.assistant",
        "kural.modelRouter.modelPreferences"
      ]
    }
  },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kural.router.forget",
        "title": "Kural: Forget What Model Router Learned (This Workspace)"
      },
      {
        "command": "kural.tab.forget",
        "title": "Kural: Forget What Tab Completion Learned (This Workspace)"
      },
      {
        "command": "kural.chat.open",
        "title": "Kural: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kural.chat.newTab",
        "title": "Kural: New Chat Tab",
        "icon": "$(add)"
      },
      {
        "command": "kural.chat.nextTab",
        "title": "Kural: Next Chat Tab"
      },
      {
        "command": "kural.chat.prevTab",
        "title": "Kural: Previous Chat Tab"
      },
      {
        "command": "kural.chat.closeTab",
        "title": "Kural: Close Chat Tab"
      },
      {
        "command": "kural.chat.moveToPanel",
        "title": "Kural: Move Chat Back to the Kural Panel",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "kural.askSearch",
        "title": "Kural: Ask Where Something Is",
        "icon": "$(search)"
      },
      {
        "command": "kural.inlineEdit",
        "title": "Kural: Edit Inline (Ctrl+K)",
        "icon": "$(sparkle)"
      },
      {
        "command": "kural.review.accept",
        "title": "Kural: Accept Change"
      },
      {
        "command": "kural.review.reject",
        "title": "Kural: Reject Change"
      },
      {
        "command": "kural.toggleTab",
        "title": "Kural: Turn Tab Completion On/Off"
      },
      {
        "command": "kural.openClaudeCode",
        "title": "Kural: Open Claude Code",
        "icon": "$(terminal)"
      },
      {
        "command": "kural.welcome",
        "title": "Welcome",
        "icon": "$(home)",
        "category": "Kural"
      },
      {
        "command": "kural.getStarted",
        "title": "Get Started",
        "icon": "$(rocket)",
        "category": "Kural"
      },
      {
        "command": "kural.showUsage",
        "title": "Show AI Usage (limits and when they reset)",
        "icon": "$(dashboard)",
        "category": "Kural"
      },
      {
        "command": "kural.account",
        "title": "Kural Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kural.devices",
        "title": "Devices (SSH): Terminal, Link to Chat, Password, Remove",
        "category": "Kural",
        "icon": "$(remote)"
      },
      {
        "command": "kural.devices.add",
        "title": "Add a Device (SSH)",
        "category": "Kural"
      },
      {
        "command": "kural.devices.terminal",
        "title": "Open a Terminal on a Device (SSH)",
        "category": "Kural"
      },
      {
        "command": "kural.login",
        "title": "Kural: Log In to Claude"
      },
      {
        "command": "kural.install",
        "title": "Kural: Install Claude Code"
      },
      {
        "command": "kural.showLog",
        "title": "Kural: Show Log",
        "icon": "$(output)"
      },
      {
        "command": "kural.chat.history",
        "title": "Kural: Chat History",
        "icon": "$(history)"
      },
      {
        "command": "kural.chat.nextModel",
        "title": "Kural: Next Model (Opus → Sonnet → Haiku)"
      },
      {
        "command": "kural.chat.effortMedium",
        "title": "Kural: Intensity Medium"
      },
      {
        "command": "kural.chat.effortHigh",
        "title": "Kural: Intensity High"
      },
      {
        "command": "kural.chat.effortMax",
        "title": "Kural: Intensity Max"
      },
      {
        "command": "kural.chat.togglePlan",
        "title": "Kural: Plan Mode On/Off"
      },
      {
        "command": "kural.chat.attach",
        "title": "Kural: Attach Files to Chat"
      },
      {
        "command": "kural.tabSpeed",
        "title": "Kural: Tab Completion Speed"
      },
      {
        "command": "kural.reloadSetup",
        "title": "Kural: Reload Claude Code Setup (connectors, MCP, plugins)"
      },
      {
        "command": "kural.checkForUpdates",
        "title": "Check for Updates...",
        "category": "Kural"
      },
      {
        "command": "kural.chat.split",
        "title": "Kural: Open a Chat Beside the Code",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "kural.search.find",
        "title": "Kural: Search in Files"
      },
      {
        "command": "kural.search.replace",
        "title": "Kural: Replace in Files"
      },
      {
        "command": "kural.search.inFolder",
        "title": "Find in Folder..."
      },
      {
        "command": "kural.search.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kural.search.clear",
        "title": "Clear Search Results",
        "icon": "$(clear-all)"
      },
      {
        "command": "kural.search.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "kural.search.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "kural.search.viewAsTree",
        "title": "View as Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "kural.search.viewAsList",
        "title": "View as List",
        "icon": "$(list-flat)"
      },
      {
        "command": "kural.search.openEditor",
        "title": "Open in Search Editor",
        "icon": "$(new-file)"
      },
      {
        "command": "kural.search.next",
        "title": "Kural: Next Search Result"
      },
      {
        "command": "kural.search.prev",
        "title": "Kural: Previous Search Result"
      },
      {
        "command": "kural.search.copy",
        "title": "Copy"
      },
      {
        "command": "kural.search.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "kural.search.copyAll",
        "title": "Copy All"
      },
      {
        "command": "kural.search.reveal",
        "title": "Reveal in Explorer View"
      },
      {
        "command": "kural.search.dismiss",
        "title": "Dismiss"
      },
      {
        "command": "kural.browser.open",
        "title": "Kural: Open Browser (Pick Elements for the Chat)",
        "icon": "$(globe)"
      },
      {
        "command": "kural.modelRouter",
        "title": "Kural: Model Router",
        "icon": "$(git-compare)"
      },
      {
        "command": "kural.scm.commitMessage",
        "title": "Kural: Suggest a Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "kural.settings.export",
        "title": "Kural: Export Settings"
      },
      {
        "command": "kural.settings.import",
        "title": "Kural: Import Settings"
      },
      {
        "command": "kural.showCrashReports",
        "title": "Kural: Show Crash Reports"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kural-search",
          "title": "Search & Ask",
          "icon": "media/search-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "kural",
          "title": "Kural",
          "icon": "media/chat-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "kural-tab",
          "title": "Tab Completion",
          "icon": "media/chat-icon.svg"
        },
        {
          "id": "kural-usage",
          "title": "AI Usage",
          "icon": "media/usage-icon.svg"
        },
        {
          "id": "kural-router",
          "title": "Model Router",
          "icon": "media/usage-icon.svg"
        }
      ]
    },
    "views": {
      "kural-search": [
        {
          "type": "webview",
          "id": "kural.search",
          "name": "Search & Ask"
        }
      ],
      "kural": [
        {
          "type": "webview",
          "id": "kural.chat",
          "name": "Chat",
          "initialSize": 30
        }
      ],
      "kural-tab": [
        {
          "type": "webview",
          "id": "kural.tabPanel",
          "name": "Tab Completion"
        }
      ],
      "kural-usage": [
        {
          "type": "webview",
          "id": "kural.usagePanel",
          "name": "AI Usage"
        }
      ],
      "kural-router": [
        {
          "type": "webview",
          "id": "kural.routerPanel",
          "name": "Model Router"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kural.chat.newTab",
          "when": "view == kural.chat",
          "group": "navigation@1"
        },
        {
          "command": "kural.showLog",
          "when": "view == kural.chat",
          "group": "navigation@4"
        },
        {
          "command": "kural.account",
          "when": "view == kural.chat",
          "group": "9_kural@1"
        },
        {
          "command": "kural.getStarted",
          "when": "view == kural.chat",
          "group": "9_kural@2"
        },
        {
          "command": "kural.search.refresh",
          "when": "view == kural.search && kural.searchTab != ask",
          "group": "navigation@1"
        },
        {
          "command": "kural.search.clear",
          "when": "view == kural.search && kural.searchTab != ask && kural.searchHasResults",
          "group": "navigation@2"
        },
        {
          "command": "kural.search.openEditor",
          "when": "view == kural.search && kural.searchTab != ask",
          "group": "navigation@3"
        },
        {
          "command": "kural.search.viewAsTree",
          "when": "view == kural.search && kural.searchTab != ask && !kural.searchTree",
          "group": "navigation@4"
        },
        {
          "command": "kural.search.viewAsList",
          "when": "view == kural.search && kural.searchTab != ask && kural.searchTree",
          "group": "navigation@4"
        },
        {
          "command": "kural.search.collapseAll",
          "when": "view == kural.search && kural.searchTab != ask && kural.searchHasResults && !kural.searchCollapsed",
          "group": "navigation@5"
        },
        {
          "command": "kural.search.expandAll",
          "when": "view == kural.search && kural.searchTab != ask && kural.searchHasResults && kural.searchCollapsed",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "kural.chat.open",
          "group": "navigation@90"
        },
        {
          "command": "kural.chat.moveToPanel",
          "when": "activeCustomEditorId == kural.chatTab || activeWebviewPanelId == kural.chatEditor",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "kural.inlineEdit",
          "when": "editorTextFocus",
          "group": "0_kural@1"
        },
        {
          "command": "kural.chat.open",
          "when": "editorHasSelection",
          "group": "0_kural@2"
        },
        {
          "command": "kural.askSearch",
          "group": "0_kural@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kural.review.accept",
          "when": "kural.reviewPending"
        },
        {
          "command": "kural.review.reject",
          "when": "kural.reviewPending"
        },
        {
          "command": "kural.search.inFolder",
          "when": "false"
        },
        {
          "command": "kural.search.refresh",
          "when": "false"
        },
        {
          "command": "kural.search.clear",
          "when": "false"
        },
        {
          "command": "kural.search.collapseAll",
          "when": "false"
        },
        {
          "command": "kural.search.expandAll",
          "when": "false"
        },
        {
          "command": "kural.search.viewAsTree",
          "when": "false"
        },
        {
          "command": "kural.search.viewAsList",
          "when": "false"
        },
        {
          "command": "kural.search.openEditor",
          "when": "false"
        },
        {
          "command": "kural.search.copy",
          "when": "false"
        },
        {
          "command": "kural.search.copyPath",
          "when": "false"
        },
        {
          "command": "kural.search.copyAll",
          "when": "false"
        },
        {
          "command": "kural.search.reveal",
          "when": "false"
        },
        {
          "command": "kural.search.dismiss",
          "when": "false"
        },
        {
          "command": "kural.chat.moveToPanel",
          "when": "activeCustomEditorId == kural.chatTab || activeWebviewPanelId == kural.chatEditor"
        }
      ],
      "webview/context": [
        {
          "command": "kural.search.copy",
          "when": "webviewId == 'kural.search' && webviewSection == 'match'",
          "group": "1_copy@1"
        },
        {
          "command": "kural.search.copy",
          "when": "webviewId == 'kural.search' && webviewSection == 'file'",
          "group": "1_copy@1"
        },
        {
          "command": "kural.search.copyPath",
          "when": "webviewId == 'kural.search' && webviewSection =~ /^(file|match)$/",
          "group": "1_copy@2"
        },
        {
          "command": "kural.search.copyAll",
          "when": "webviewId == 'kural.search' && webviewSection =~ /^(file|match|dir)$/",
          "group": "1_copy@3"
        },
        {
          "command": "kural.search.reveal",
          "when": "webviewId == 'kural.search' && webviewSection =~ /^(file|match)$/",
          "group": "2_reveal@1"
        },
        {
          "command": "kural.search.dismiss",
          "when": "webviewId == 'kural.search' && webviewSection =~ /^(file|match|dir)$/",
          "group": "3_dismiss@1"
        }
      ],
      "explorer/context": [
        {
          "command": "kural.search.inFolder",
          "when": "explorerResourceIsFolder",
          "group": "4_search@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "kural.chat.moveToPanel",
          "when": "resourceScheme == kural-chat",
          "group": "1_kural"
        }
      ],
      "scm/inputBox": [
        {
          "command": "kural.scm.commitMessage",
          "when": "scmProvider == git"
        }
      ],
      "scm/title": [
        {
          "command": "kural.scm.commitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kural.chat.open",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "!terminalFocus"
      },
      {
        "command": "kural.chat.newTab",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "kural.chat.nextTab",
        "key": "ctrl+pagedown",
        "mac": "cmd+alt+right",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.prevTab",
        "key": "ctrl+pageup",
        "mac": "cmd+alt+left",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.askSearch",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "kural.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "kural.review.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "kural.reviewPending && editorTextFocus"
      },
      {
        "command": "kural.review.reject",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "kural.reviewPending && editorTextFocus"
      },
      {
        "command": "kural.openClaudeCode",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "kural.chat.effortMedium",
        "key": "ctrl+m",
        "mac": "ctrl+m",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.effortHigh",
        "key": "ctrl+h",
        "mac": "ctrl+h",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.effortMax",
        "key": "ctrl+o",
        "mac": "ctrl+o",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.chat.togglePlan",
        "key": "ctrl+p",
        "mac": "ctrl+p",
        "when": "kural.chatFocused || focusedView == 'kural.chat'"
      },
      {
        "command": "kural.toggleTab",
        "key": "ctrl+alt+space",
        "mac": "ctrl+alt+space"
      },
      {
        "command": "kural.search.find",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f"
      },
      {
        "command": "kural.search.replace",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      },
      {
        "command": "kural.search.next",
        "key": "f4",
        "when": "kural.searchHasResults"
      },
      {
        "command": "kural.search.prev",
        "key": "shift+f4",
        "when": "kural.searchHasResults"
      }
    ],
    "configuration": {
      "title": "Kural",
      "properties": {
        "kural.claudePath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Where the `claude` program (Claude Code) is. Leave empty to find it automatically; set it only if Kural can't find yours (Get started → *Choose the claude file…*)."
        },
        "kural.codexPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Where the `codex` program (OpenAI's Codex CLI) is. Leave empty to find it automatically."
        },
        "kural.agyPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Where the `agy` program (Google's Antigravity CLI, for Google Gemini) is. Leave empty to find it automatically."
        },
        "kural.tabCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tab Completion: show suggestions as grey text as you type. Tab accepts."
        },
        "kural.tabCompletion.model": {
          "type": "string",
          "default": "haiku",
          "enum": [
            "haiku",
            "sonnet",
            "opus"
          ],
          "description": "Claude model for Tab Completion (when it uses Claude). Haiku is fastest (about half a second)."
        },
        "kural.tabCompletion.debounceMs": {
          "type": "number",
          "default": 75,
          "minimum": 0,
          "maximum": 2000,
          "description": "How fast suggestions come: ms to wait after your last key (0 = as you type). Easiest to set in the Tab Completion panel (the sparkle in the status bar)."
        },
        "kural.chat.model": {
          "type": "string",
          "default": "sonnet",
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ],
          "description": "Model for your very first chat. After that, new chats use whatever you picked last."
        },
        "kural.chat.intensity": {
          "type": "string",
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ],
          "description": "Intensity for your very first chat. After that, new chats use whatever you picked last."
        },
        "kural.chat.mode": {
          "type": "string",
          "default": "agent",
          "enum": [
            "agent",
            "auto",
            "plan",
            "ask"
          ],
          "enumDescriptions": [
            "Kural edits files; asks before running commands",
            "Kural edits files and runs commands without asking",
            "Kural writes a plan first; click Build it to carry it out",
            "Answers only; nothing changes"
          ],
          "description": "Mode for your very first chat. After that, new chats use whatever you picked last."
        },
        "kural.chat.fullClaudeCodeSetup": {
          "type": "boolean",
          "default": true,
          "description": "Chat uses your whole Claude Code setup: connectors and MCP servers, plugins, skills, hooks, settings. Kural reloads it in the same conversation when it changes. Off = a faster, minimal setup (your CLAUDE.md and .claude/rules are still used)."
        },
        "kural.notifications": {
          "type": "string",
          "enum": [
            "whenAway",
            "always",
            "off"
          ],
          "enumDescriptions": [
            "Only when you're not looking: Kural's window isn't in front, or that chat isn't on screen",
            "Every time an answer finishes or needs you",
            "Never"
          ],
          "default": "whenAway",
          "markdownDescription": "A system notification when a chat's answer is done or needs you (a command to allow, a question, a plan to build, an error). macOS asks once whether Kural may send notifications."
        },
        "kural.chat.didYouKnow": {
          "type": "boolean",
          "default": true,
          "description": "While an answer is being worked on, show a short \"Did you know?\" tip or fact under it, with a Know more link."
        },
        "kural.chat.moods": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "maxLength": 30
              },
              "hint": {
                "type": "string",
                "maxLength": 80
              },
              "instructions": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "name",
              "instructions"
            ]
          },
          "markdownDescription": "Your own moods for the chat, next to Default, Explorer, Critic and Learn: a name, a one-line hint, and instructions for the AI. Edit them in **Kural Settings → Moods**."
        },
        "kural.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Text size in the Kural chat and Ask panels, in pixels. `0` = the same as your code editor (`editor.fontSize`)."
        },
        "kural.tabCompletion.engine": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "local",
            "claude"
          ],
          "enumDescriptions": [
            "The local model when Ollama has it (fastest), otherwise Claude",
            "Always the local model (Claude only if Ollama isn't available)",
            "Always Claude"
          ],
          "description": "What writes Tab Completion suggestions. Easiest to set in the Tab Completion panel (the sparkle in the status bar)."
        },
        "kural.tabCompletion.localModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b-base",
          "description": "Ollama model for local Tab Completion suggestions (a base model with fill-in-the-middle, e.g. qwen2.5-coder:1.5b-base / 3b-base)."
        },
        "kural.tabCompletion.ollamaUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:11434",
          "description": "Where Ollama runs."
        },
        "kural.localModels.contextLength": {
          "type": "number",
          "default": 32768,
          "minimum": 16384,
          "markdownDescription": "How many tokens a model on your computer (Ollama) can look at in the chat: your conversation, the files it read, Kural's instructions. 32k works well; more needs more memory."
        },
        "kural.tabCompletion.terminal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Tab in the terminal too: one suggested command line in the terminal's suggestion list (e.g. a commit message named from your changes). Uses the same engine and model as Tab in the editor."
        },
        "kural.updates.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "Check for a new Kural version once a day (it asks before installing anything)."
        },
        "kural.showDebugViews": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show VS Code's **Run and Debug** side bar and the **Debug Console** and **Ports** panels. Off by default to keep Kural simple; while you debug (F5), the debug views show anyway."
        },
        "kural.modelRouter.profile": {
          "type": "string",
          "enum": [
            "balance",
            "cost",
            "intelligence"
          ],
          "enumDescriptions": [
            "Meet the task's quality needs, then prefer speed; steer away from an AI close to its limit",
            "Save your usage limits: the lightest model that can do the task, on the AI with the most room left",
            "Prefer the most capable model, even when it's slower or uses more of your limits"
          ],
          "default": "balance",
          "description": "Auto profile of a new chat until you pick one in the chat's model menu (Auto → Balance, Cost or Intelligence; a new chat then keeps your last pick). Also what Tab's Auto engine follows (kural.modelRouter.tab)."
        },
        "kural.modelRouter.saveTokens": {
          "type": "boolean",
          "default": false,
          "description": "Ask the router to prefer fewer tokens and retries while meeting the selected profile."
        },
        "kural.modelRouter.timeoutMs": {
          "type": "integer",
          "default": 1500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum time for optional local router assistance before native policy takes over."
        },
        "kural.modelRouter.search": {
          "type": "boolean",
          "default": false,
          "description": "Rank local Search & Ask candidates with native matching or the selected local helper, then fall back to the existing AI search when needed."
        },
        "kural.modelRouter.context": {
          "type": "boolean",
          "default": false,
          "description": "Retrieve and rank optional workspace snippets for chat. Explicit attachments and instructions are preserved."
        },
        "kural.modelRouter.contextChars": {
          "type": "integer",
          "default": 12000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Character budget for automatically retrieved context, excluding explicit attachments."
        },
        "kural.modelRouter.handoffChars": {
          "type": "integer",
          "default": 120000,
          "minimum": 10000,
          "maximum": 1000000,
          "description": "Maximum recorded conversation size for an automatic provider handoff. Larger conversations stay intact and require a manual choice or larger budget."
        },
        "kural.modelRouter.checkpoints": {
          "type": "boolean",
          "default": true,
          "description": "Reassess after failed tool steps in Auto model selection. Live switching currently supports Claude and local models within their provider."
        },
        "kural.modelRouter.tab": {
          "type": "boolean",
          "default": false,
          "description": "When Tab Completion's engine is Auto, let the profile setting (kural.modelRouter.profile) pick one engine: Intelligence prefers Claude, Cost and Balance the local model. No helper model runs while typing."
        },
        "kural.modelRouter.assistant": {
          "type": "string",
          "enum": [
            "native",
            "minilm",
            "granite",
            "qwen3"
          ],
          "enumDescriptions": [
            "Kural's word classifier: built in, instant",
            "MiniLM (all-minilm:22m, 46 MB) through Ollama on this computer, with the word classifier",
            "Granite (granite-embedding:30m, 63 MB) through Ollama, with the word classifier: a good balance",
            "Qwen3 Embedding (qwen3-embedding:0.6b, 640 MB) through Ollama, with the word classifier: the most accurate"
          ],
          "default": "native",
          "description": "How Auto reads how much work a request is. The helper models run through Ollama on this computer (download them in Model Router); without one, Kural's built-in word classifier decides."
        },
        "kural.modelRouter.modelPreferences": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "quality": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "speed": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            },
            "additionalProperties": false
          },
          "description": "Per-model quality, speed and token-efficiency hints, rated 1 (low) to 3 (high). These are not measured guarantees."
        }
      }
    },
    "themes": [
      {
        "label": "Kural Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kural-dark-color-theme.json"
      },
      {
        "label": "Kural Light",
        "uiTheme": "vs",
        "path": "./themes/kural-light-color-theme.json"
      }
    ],
    "icons": {
      "kural-tab-off": {
        "description": "Tab Completion is off (its sparkle, crossed out)",
        "default": {
          "fontPath": "./media/codicons/kural-icons.ttf",
          "fontCharacter": "\\E001"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "welcome",
        "title": "Get started with Kural",
        "description": "Set up your AI, open a project, and make your first change.",
        "icon": "media/chat-icon.svg",
        "steps": [
          {
            "id": "setup",
            "title": "Choose your AI",
            "description": "Use Claude, Google Gemini, ChatGPT (Codex), or a model on your computer. Kural helps you install it, log in, and check that it works.\n[Set up your AI](command:kural.getStarted)",
            "completionEvents": ["onContext:kural.aiReady"],
            "media": { "markdown": "media/welcome-setup.md" }
          },
          {
            "id": "project",
            "title": "Open a project",
            "description": "Open a folder to work with its files, or clone a Git repository.\n[Open Folder](command:workbench.action.files.openFolder)\n[Clone Git Repository](command:git.clone)",
            "completionEvents": ["onContext:workspaceFolderCount != 0"],
            "media": { "markdown": "media/welcome-project.md" }
          },
          {
            "id": "chat",
            "title": "Make your first change",
            "description": "Tell Kural what you want to change. Review each edit, then keep it or undo it.\n[Open Chat](command:kural.chat.open)",
            "completionEvents": ["onCommand:kural.chat.open"],
            "media": { "markdown": "media/welcome-chat.md" }
          },
          {
            "id": "theme",
            "title": "Make the editor yours",
            "description": "Choose Kural Dark, Kural Light, or another installed theme.\n[Choose a Color Theme](command:workbench.action.selectTheme)",
            "completionEvents": ["onCommand:workbench.action.selectTheme"],
            "media": { "markdown": "media/welcome-theme.md" }
          }
        ]
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Kural Dark",
      "github.branchProtection": false,
      "github.showAvatar": false,
      "github.gitAuthentication": false,
      "workbench.preferredDarkColorTheme": "Kural Dark",
      "workbench.preferredLightColorTheme": "Kural Light",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.startupEditor": "welcomePage",
      "workbench.welcomePage.extraAnnouncements": false,
      "workbench.welcomePage.walkthroughs.openOnInstall": false,
      "workbench.tips.enabled": false,
      "workbench.browser.openLocalhostLinks": true,
      "chat.commandCenter.enabled": false,
      "chat.disableAIFeatures": true,
      "editor.fontSize": 14,
      "editor.lineHeight": 1.6,
      "editor.minimap.enabled": false,
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.renderLineHighlight": "all",
      "editor.inlineSuggest.enabled": true,
      "editor.guides.bracketPairs": "active",
      "workbench.list.smoothScrolling": true,
      "terminal.integrated.fontSize": 14,
      "terminal.integrated.initialHint": false,
      "workbench.activityBar.location": "default",
      "workbench.sideBar.location": "left",
      "workbench.experimental.fontSize": 14,
      "workbench.sideBar.experimental.fontSize": 14,
      "workbench.tabs.experimental.fontSize": 14,
      "workbench.bottomPane.experimental.fontSize": 14,
      "workbench.statusBar.experimental.fontSize": 13,
      "terminal.integrated.suggest.quickSuggestions": {
        "commands": "on",
        "arguments": "on",
        "unknown": "on"
      },
      "terminal.integrated.suggest.suggestOnTriggerCharacters": true
    },
    "terminal": {
      "completionProviders": [
        {
          "description": "Tab Completion: one suggested command line (e.g. a commit message named from your changes), from the same model as Tab in the editor."
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "kural.chatTab",
        "displayName": "Kural Chat",
        "selector": [
          {
            "filenamePattern": "*.kuralchat"
          }
        ],
        "priority": "default"
      }
    ]
  },

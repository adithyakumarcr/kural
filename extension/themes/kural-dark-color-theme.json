  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6c6a7a", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#98c379" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#5fc7c7" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#e09a6a" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#b18cfa" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#a0a0b0" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#d6c8f5" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#d4d4d8" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#e5707a", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#e5707a" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#9cdcfe" } },
    { "scope": ["entity.name.decorator", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#c4b0ff", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#98c379" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e5707a" } }
  ],
  "semanticTokenColors": {
    "function": "#82aaff",
    "method": "#82aaff",
    "class": "#e5c07b",
    "type": "#e5c07b",
    "parameter": "#d6c8f5",
    "property": "#c8c8d0",
    "enumMember": "#e09a6a",
    "selfParameter": { "foreground": "#e5707a", "italic": true }
  }
}
